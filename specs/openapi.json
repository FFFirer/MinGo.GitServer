        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GitTree": {
        "required": [
          "head",
          "entries"
        ],
        "type": "object",
        "properties": {
          "head": {
            "type": [
              "null",
